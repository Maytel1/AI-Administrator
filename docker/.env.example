# Скопируйте:  copy .env.example .env   — файл .env в git НЕ попадает (в .gitignore)
# --- PostgreSQL (локальный контейнер) ---
POSTGRES_USER=aiadmin
POSTGRES_PASSWORD=aiadmin_dev
POSTGRES_DB=aiadmin
POSTGRES_PORT=5433
# BOT_HTTP_PORT=8080
# CALL_HTTP_PORT=8081

# --- LLM (YandexGPT — рекомендация PDN_LLM_OPTIONS.md; gpt-4o-mini — позже для A/B) ---
# LLM_PROVIDER=yandexgpt          # yandexgpt | openai | deepseek
# YC_API_KEY=                     # API-ключ сервисного аккаунта Yandex Cloud
# YC_FOLDER_ID=                   # идентификатор каталога

# --- SpeechKit (фаза 3, голос) ---
# YC_SPEECHKIT_API_KEY=

# --- Telegram (фаза 2; токен от @BotFather) ---
# TELEGRAM_BOT_TOKEN=

# --- Наблюдаемость и защита бота (фаза 2) ---
# BOT_HTTP_PORT=8080         # /health и /metrics (порт проброшен в compose)
# TG_RATE_LIMIT=6            # сообщений на чат...
# TG_RATE_WINDOW=10          # ...за столько секунд (скользящее окно)

# --- Веб-панель (фаза 4; порт проброшен в compose) ---
# WEB_HTTP_PORT=8082      # сама панель: http://localhost:8082/today
# WEB_HEALTH_PORT=8083    # /health и /metrics панели
# Вход только по учётным записям panel_users (PBKDF2 + TOTP-2FA).
# Общего пароля нет: он давал бы роль team с доступом ко всем точкам.
# WEB_PUBLIC_HOST=panel.example.ru   # домены панели для редиректа HTTP->HTTPS (через запятую)

# --- worker: напоминания, лист ожидания, тревоги ---
# WORKER_TICK=60          # как часто проходить по точкам, секунд
# WORKER_HEALTH_PORT=8084 # /health и /metrics worker'а на хосте
# OWNER_TG_CHAT_ID=       # куда слать тревоги; пусто — молча пишем в лог

# --- call-service: голосовой контур (фаза 3) ---
# CALL_API_TOKEN=         # токен для POST /call/*; пусто — сервис не принимает запросы
# CALL_HTTP_PORT=8081     # API звонков на хосте
# CALL_HEALTH_PORT=8085   # /health и /metrics на хосте
# YC_API_KEY=             # SpeechKit: без него работает автоответчик
# YC_FOLDER_ID=

# --- Телефония (фаза 3; Zadarma / Mango / UIS) ---
# SIP_LOGIN=
# SIP_PASSWORD=
