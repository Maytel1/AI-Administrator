# Скопируйте:  copy .env.example .env   — файл .env в git НЕ попадает (в .gitignore)
# --- PostgreSQL (локальный контейнер) ---
POSTGRES_USER=aiadmin
POSTGRES_PASSWORD=aiadmin_dev
POSTGRES_DB=aiadmin
POSTGRES_PORT=5433
# BOT_HTTP_PORT=8080
# CALL_HTTP_PORT=8081

# --- LLM (YandexGPT — рекомендация PDN_LLM_OPTIONS.md; gpt-4o-mini — позже для A/B) ---
# LLM_PROVIDER=yandexgpt          # yandexgpt | openai | deepseek
# LLM_MAX_TOKENS=1024             # лимит длины ответа LLM (защита от «бомбы по деньгам»)
# YC_API_KEY=                     # API-ключ сервисного аккаунта Yandex Cloud
# YC_FOLDER_ID=                   # идентификатор каталога

# --- SpeechKit (фаза 3, голос) ---
# YC_SPEECHKIT_API_KEY=

# --- Telegram (фаза 2; токен от @BotFather) ---
# TELEGRAM_BOT_TOKEN=

# --- Наблюдаемость и защита бота (фаза 2) ---
# BOT_HTTP_PORT=8080         # /health и /metrics (порт проброшен в compose)
# TG_RATE_LIMIT=6            # сообщений на чат...
# TG_RATE_WINDOW=10          # ...за столько секунд (скользящее окно)

# --- Веб-панель (фаза 4; порт проброшен в compose) ---
# WEB_HTTP_PORT=8082      # сама панель: http://localhost:8082/today
# WEB_HEALTH_PORT=8083    # /health и /metrics панели
# Вход только по учётным записям panel_users (PBKDF2 + TOTP-2FA).
# Общего пароля нет: он давал бы роль team с доступом ко всем точкам.
# WEB_PUBLIC_HOST=panel.example.ru   # домены панели для редиректа HTTP->HTTPS (через запятую)

# --- worker: напоминания, лист ожидания, тревоги ---
# WORKER_TICK=60          # как часто проходить по точкам, секунд
# WORKER_HEALTH_PORT=8084 # /health и /metrics worker'а на хосте
# OWNER_TG_CHAT_ID=       # куда слать тревоги; пусто — молча пишем в лог

# --- call-service: голосовой контур (фаза 3) ---
# CALL_API_TOKEN=         # токен для POST /call/*; пусто — сервис не принимает запросы
# CALL_HTTP_PORT=8081     # API звонков на хосте
# CALL_HEALTH_PORT=8085   # /health и /metrics на хосте
# YC_API_KEY=             # SpeechKit: без него работает автоответчик
# YC_FOLDER_ID=

# --- Телефония (фаза 3; Zadarma / Mango / UIS) ---
# SIP_LOGIN=
# SIP_PASSWORD=
# WhatsApp (Meta Cloud API): сервис не стартует без первых трёх.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Подпись webhook: без неё принимать сообщения нельзя (см. channels/whatsapp_auth.py).
WHATSAPP_APP_SECRET=
# Оплата: ручной счёт + СБП по реквизитам, тарифы помесячные.
# Без BILLING_LEGAL_NAME раздел «Тариф и оплата» покажет подсказку
# вместо реквизитов: счёт просто некуда отправить.
BILLING_LEGAL_NAME=
BILLING_INN=
BILLING_KPP=
BILLING_BANK=
BILLING_BIK=
BILLING_ACCOUNT=
# Цены помесячных тарифов, JSON. Меняются без выкатки кода.
BILLING_PRICES={"start": 5000, "standard": 12000, "pro": 15000}

# Единый часовой пояс проекта: UTC+5 без перехода на летнее время.
# Должен совпадать с таймзоном салонов, иначе даты счетов и отчётов разъедутся.
DB_TIMEZONE=Asia/Yekaterinburg

# --- Вынос бэкапов в объектное хранилище -----------------------------------
# Копии на том же диске, что и сервер, — это не резерв: погибнет диск —
# пропадут и копии. Любое S3-совместимое хранилище (Yandex Object Storage,
# Selectel, Timeweb). Залив делает scripts/upload_backup.py и проверяет,
# что копия читается, а не просто загрузилась.
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_BUCKET=backups-aiadmin
# S3_REGION=ru-central1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PREFIX=db          # префикс пути в бакете, по умолчанию db

# --- Алерты в Telegram (Prometheus → Alertmanager → alert-relay) -------------
# Прямой api.telegram.org с этой машины недоступен, поэтому alert-relay ходит
# через тот же Worker-прокси, что и telegram-relay. Пока указан тот же бот и
# чат; когда появится отдельный бот для алертов, поменяйте три строки ниже и
# перезапустите alert-relay. Токен в git не попадает (.env в .gitignore).
# TG_ALERT_API_BASE=https://<worker>.workers.dev
# TG_ALERT_TOKEN=
# TG_ALERT_CHAT_ID=
